    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst d = b.data;\n\n// ignora mensagens que eu mesmo mando\nif (d.key?.fromMe === true) {\n  return [];\n}\n\nconst texto = d.message?.conversation || d.message?.extendedTextMessage?.text || \"\";\n\n// código Airbnb (HM+8) ou Booking (10 dígitos)\nconst matchAirbnb = texto.match(/HM[A-Z0-9]{8}/i);\nconst matchBooking = texto.match(/\\b\\d{10}\\b/);\nconst codigo = matchAirbnb ? matchAirbnb[0].toUpperCase() : (matchBooking ? matchBooking[0] : null);\n\n// tira o código do texto antes de procurar o telefone\nlet textoSemCodigo = texto;\nif (codigo) textoSemCodigo = texto.replace(codigo, \"\");\n\n// procura o telefone: 10 ou 11 dígitos no que sobrou\nconst digitos = textoSemCodigo.replace(/\\D/g, \"\");\nconst matchTelefone = digitos.match(/(\\d{10,11})/);\nlet telefone = matchTelefone ? matchTelefone[1] : \"\";\nif (telefone && !telefone.startsWith(\"55\")) telefone = \"55\" + telefone;\n\n// tem as duas coisas?\nconst temTudo = (codigo && telefone) ? true : false;\nconst remetenteLid = d.key?.remoteJid || \"\";\n\nreturn [{\n  json: {\n    codigo: codigo,\n    telefone: telefone,\n    temTudo: temTudo,\n    remetenteLid: remetenteLid,\n    textoOriginal: texto,\n    pushName: d.pushName || \"\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
