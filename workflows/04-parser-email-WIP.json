    {
      "parameters": {
        "jsCode": "// Função auxiliar para formatar a data para AAAA-MM-DD (Padrão aceito pelo Airtable)\nfunction formatarDataAirtable(dataStr) {\n  if (!dataStr) return null;\n  const [dia, mes, ano] = dataStr.split('/');\n  return `${ano}-${mes}-${dia}`;\n}\n\n// formata data pt-BR (ex: \"22 de agosto\")\nfunction dataBonita(dataAirtable) {\n  if (!dataAirtable) return \"\";\n  const [ano, mes, dia] = dataAirtable.split('-').map(Number);\n  const meses = [\"janeiro\",\"fevereiro\",\"março\",\"abril\",\"maio\",\"junho\",\"julho\",\"agosto\",\"setembro\",\"outubro\",\"novembro\",\"dezembro\"];\n  return `${dia} de ${meses[mes - 1]}`;\n}\n\nfor (const item of $input.all()) {\n  // Pega o texto do e-mail vindo do IMAP / Gmail\n  const body = item.json.textPlain || item.json.textHtml || item.json.text || item.json.snippet || \"\";\n  const subject = item.json.subject || \"\";\n  const fullContent = (subject + ' ' + body).toLowerCase();\n  // 1. Identifica se o e-mail é de Cancelamento\n  const isCancelamento = /cancelad|cancellation|cancelled/i.test(fullContent);\n  // 2. Extrai o ID da Reserva (Código Airbnb ou Booking)\n  const matchAirbnb = body.match(/HM[A-Z0-9]{8,10}/i);\n  const matchBooking = body.match(/\\b\\d{9,11}\\b/);\n  let idReserva = null;\n  if (matchAirbnb) {\n    idReserva = matchAirbnb[0];\n  } else if (matchBooking) {\n    idReserva = matchBooking[0];\n  }\n  // 3. Regex para capturar os dados do hóspede e reserva\n  const nomeMatch = body.match(/Hóspede:\\s*([^\\n\\r]+)/i) || body.match(/Reserva de ([^\\n\\r]+)/i);\n  const valorMatch = body.match(/Valor Total:\\s*R\\$\\s*([\\d\\.,]+)/i) || body.match(/R\\$\\s*([\\d\\.,]+)/i);\n  const foneMatch = body.match(/Telefone:\\s*([\\(\\)\\d\\s\\-]+)/i) || body.match(/(\\(?\\d{2}\\)?\\s?\\d{4,5}\\-?\\d{4})/);\n\n  // Captura Check-in e Check-out (formato DD/MM/AAAA)\n  const checkInMatch = body.match(/Check-in:\\s*(\\d{2}\\/\\d{2}\\/\\d{4})/i);\n  const checkOutMatch = body.match(/Check-out:\\s*(\\d{2}\\/\\d{2}\\/\\d{4})/i);\n  // 4. Identifica a Plataforma pelo Assunto ou Corpo do e-mail\n  let plataforma = \"Outro\";\n  if (/airbnb/i.test(subject) || /airbnb/i.test(body)) {\n    plataforma = \"Airbnb\";\n  } else if (/booking/i.test(subject) || /booking/i.test(body)) {\n    plataforma = \"Booking\";\n  }\n  // 5. Trata o valor monetário\n  let valorFinal = 0;\n  if (valorMatch && valorMatch[1]) {\n    const valorLimpo = valorMatch[1].trim().replace(/\\./g, '').replace(',', '.');\n    valorFinal = parseFloat(valorLimpo) || 0;\n  }\n  // 6. Decide telefone e confirmação conforme a plataforma\n  let telefoneFinal = \"\";\n  let whatsappConfirmado = false;\n  if (plataforma === \"Booking\") {\n    // Booking: telefone real vem no e-mail\n    telefoneFinal = foneMatch ? foneMatch[1].trim().replace(/\\D/g, \"\") : \"\";\n    if (telefoneFinal && !telefoneFinal.startsWith(\"55\")) telefoneFinal = \"55\" + telefoneFinal;\n    whatsappConfirmado = telefoneFinal ? true : false;\n  } else {\n    // Airbnb (ou outro): telefone é mascarado, não grava. Confirma só via WhatsApp depois.\n    telefoneFinal = \"\";\n    whatsappConfirmado = false;\n  }\n  // 7. Preenche as variáveis de saída para os próximos nós do n8n\n  item.json.isCancelamento = isCancelamento;\n  item.json.idReserva = idReserva;\n  item.json.statusReserva = isCancelamento ? 'Cancelada' : 'Confirmada';\n  item.json.nomeHospede = nomeMatch ? nomeMatch[1].trim() : \"Hóspede Não Identificado\";\n  item.json.valorTotal = valorFinal;\n  item.json.telefone = telefoneFinal;\n  item.json.whatsappConfirmado = whatsappConfirmado;\n  item.json.checkIn = checkInMatch ? formatarDataAirtable(checkInMatch[1]) : null;\n  item.json.checkOut = checkOutMatch ? formatarDataAirtable(checkOutMatch[1]) : null;\n  item.json.checkInFormatado = dataBonita(checkInMatch ? formatarDataAirtable(checkInMatch[1]) : null);\n  item.json.checkOutFormatado = dataBonita(checkOutMatch ? formatarDataAirtable(checkOutMatch[1]) : null);\n  item.json.plataforma = plataforma;\n  item.json.assunto = subject;\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
